# PostgreSQL connection used when running the API locally. Start it with: docker compose up -d db
DATABASE_URL=postgres://documind:documind-local-password@localhost:5432/documind?sslmode=disable

# Local development only. Production must set AUTH_MODE=production, a random secret,
# and run behind an HTTPS-terminating reverse proxy.
AUTH_MODE=development
LEGACY_DOCUMENT_OWNER=local-dev

AUTH_JWT_SECRET=local-development-secret-change-me-please
AUTH_JWT_ISSUER=documind
AUTH_JWT_TTL=8h
AUTH_COOKIE_SECURE=false
AUTH_REQUIRE_HTTPS=false

# Authenticated document routes require a session when AUTH_JWT_SECRET is set.
# The RAG evaluator accepts --email/--password or DOCUMIND_EVAL_EMAIL/
# DOCUMIND_EVAL_PASSWORD and preserves the login cookie across API requests.

# Directory for uploaded documents. Relative paths resolve from the api directory.
UPLOAD_DIRECTORY=../data

# Document processor and local Ollama embedding settings.
DOCUMENT_PROCESSOR_GRPC_URL=127.0.0.1:50051
DOCUMENT_JOB_MAX_ATTEMPTS=5
DOCUMENT_JOB_INITIAL_BACKOFF=5s
DOCUMENT_JOB_MAX_BACKOFF=5m
DOCUMENT_JOB_LEASE_DURATION=2m
DOCUMENT_JOB_LEASE_RENEWAL=30s
DOCUMENT_JOB_PROCESSING_TIMEOUT=30m
DOCUMENT_JOB_POLL_INTERVAL=1s
DOCUMENT_JOB_WORKERS=2
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
ANSWER_GENERATION_TIMEOUT=5m
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:7b
EMBEDDING_DIMENSIONS=768
MAX_PDF_PAGES=500
MAX_EXTRACTED_TEXT_BYTES=26214400
MAX_CHUNKS=10000
PDF_EXTRACTION_TIMEOUT=60
PDF_EXTRACTION_MEMORY_BYTES=536870912
PDF_EXTRACTION_CPU_SECONDS=60
TOKEN_CHUNK_SIZE=800
TOKEN_CHUNK_OVERLAP=80
EMBEDDING_BATCH_SIZE=32
