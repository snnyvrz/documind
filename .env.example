# PostgreSQL credentials used by the Compose database and API.
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind-local-password

# Existing documents without an owner are assigned this subject on migration.
LEGACY_DOCUMENT_OWNER=local-user

# Expired upload and answer quota reservations are recovered automatically at
# API startup and before durable quota admission. No recovery setting is needed.

# Production authentication settings for the Compose stack.
# Use a random value with at least 32 characters.
AUTH_MODE=production
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_JWT_ISSUER=documind
AUTH_JWT_TTL=8h
AUTH_COOKIE_SECURE=true
AUTH_REQUIRE_HTTPS=true

# For local plain-HTTP production-like E2E only, the Make target overrides the
# settings above with development auth, non-Secure cookies, and no HTTPS
# enforcement. Do not use those overrides for shared deployments.

# Optional processing and model overrides.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:7b
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
INGESTION_CAPACITY=2
QUESTION_CAPACITY=2
EMBEDDING_CAPACITY=2
RETRIEVAL_LIMIT=5
MAX_PDF_PAGES=500
MAX_EXTRACTED_TEXT_BYTES=26214400
MAX_CHUNKS=10000
PDF_EXTRACTION_TIMEOUT=60
PDF_EXTRACTION_MEMORY_BYTES=536870912
PDF_EXTRACTION_CPU_SECONDS=60
TOKEN_CHUNK_SIZE=800
TOKEN_CHUNK_OVERLAP=80
